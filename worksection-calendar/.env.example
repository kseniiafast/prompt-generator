# Скопіюйте цей файл у .env і заповніть своїми значеннями.
# .env НЕ комітиться в git (див. .gitignore).

# Субдомен вашого акаунту Worksection, напр. для https://eco9830.worksection.com це "eco9830"
WS_SUBDOMAIN=eco9830

# Адміністративний API-ключ: Worksection -> Налаштування акаунту -> API
WS_APIKEY=

# Ваш email у Worksection - задачі, призначені на нього, потраплять у календар
WS_USER_EMAIL=kseniia.fast@ecofactortech.com
